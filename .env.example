# Copy to .env and fill in. Never commit .env.

# OpenRouter API key (backend only, never sent to the browser)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Shown on screen during the whole demo
STUDENT_NAME=Yesaullah Sheikh
ROLL_NO=your-roll-number

# OpenRouter model IDs (verify on openrouter.ai before running)
MODEL_JEV=typesafe/jev-1.13
MODEL_LUNA=openai/gpt-6-luna-decisions
MODEL_CLEF=cloudflare/clef
MODEL_OPUS=anthropic/claude-opus-5.5

# Game rules (identical for every model)
MAX_MOVES=30
GAME_TIME_LIMIT_S=300
MOVE_TIMEOUT_S=120
MAX_RETRIES=2
RECENT_MOVES_WINDOW=5

# Opus cost controls
OPUS_REASONING_EFFORT=medium
OPUS_MAX_TOKENS=8000

# Hard stop for a benchmark session (USD, based on OpenRouter-reported cost)
BUDGET_USD=8
